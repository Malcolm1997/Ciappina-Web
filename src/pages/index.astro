---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Repuestos de calidad">
  <main class="hero">
    <img class="hero-image" src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=1350&q=80" alt="Mostrador con repuestos" />
    <h1>Repuestos de calidad para tu vehículo</h1>
    <p class="subtitle">Más de 30 años de experiencia en el rubro automotor</p>
    <a href="https://wa.me/5491112345678" class="cta">Consultanos por WhatsApp</a>
  </main>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 2rem 1rem;
    color: white;
  }
  .hero-image {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: #25D366;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
  }
</style>
